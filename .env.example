# ---- Скопіюйте у .env і заповніть. Файл .env НІКОЛИ не потрапляє в Git. ----

# local | test | prod
ENVIRONMENT=test

# Токен бота від @BotFather (окремий бот для test і для prod!)
TELEGRAM_BOT_TOKEN=

# webhook на сервері, polling для локальної розробки
BOT_MODE=webhook
# Публічна HTTPS-адреса цього середовища
PUBLIC_BASE_URL=https://tg-test.thetender.com.ua
# Випадковий рядок (наприклад: openssl rand -hex 32). Telegram повертає його в заголовку.
TELEGRAM_WEBHOOK_SECRET=

# Пароль внутрішньої бази даних (openssl rand -hex 24)
POSTGRES_PASSWORD=

# Порт на 127.0.0.1, куди nginx проксує запити: test=8083 (8081 зайнятий сайтом), prod=8082
APP_PORT=8083

# The Tender API (з Iteration 2). Sandbox для test, thetender.com.ua лише для prod.
THETENDER_BASE_URL=https://sandbox.mxuser.com
THETENDER_API_KEY=

CONSULTATION_PHONE=+38 067 333 78 00
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# Ліміти ресурсів контейнерів
APP_MEM_LIMIT=384m
APP_CPUS=0.5
DB_MEM_LIMIT=384m
DB_CPUS=0.5
