# Reverse proxy for The Tender Telegram service.
# Place into /etc/nginx/sites-available/ and enable; adjust certificate paths
# to how SSL is issued on this server (certbot example below).
#
#   sudo certbot certonly --nginx -d tg.thetender.com.ua -d tg-test.thetender.com.ua

# ---------- TEST ----------
server {
    listen 80;
    server_name tg-test.thetender.com.ua;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name tg-test.thetender.com.ua;

    ssl_certificate     /etc/letsencrypt/live/tg-test.thetender.com.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tg-test.thetender.com.ua/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ---------- PROD ----------
server {
    listen 80;
    server_name tg.thetender.com.ua;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name tg.thetender.com.ua;

    ssl_certificate     /etc/letsencrypt/live/tg.thetender.com.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tg.thetender.com.ua/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
